<odoo>
    <record id="view_whatsapp_compose_form" model="ir.ui.view">
        <field name="name">whatsapp.compose.form</field>
        <field name="model">whatsapp.compose</field>
        <field name="arch" type="xml">
            <form string="Enviar WhatsApp">
                <group>
                    <group>
                        <field name="partner_id"/>
                        <field name="phone"/>
                        <field name="account_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="res_model" invisible="1"/><field name="res_id" invisible="1"/>
                        <field name="report_id" options="{'no_create': True, 'no_open': True}" invisible="not res_model or res_model == 'res.partner'"/>
                        <field name="template_id" options="{'no_create': True}" domain="[('model_id.model', '=', res_model)]"/>
                    </group>
                </group>
                <field name="body" placeholder="Escribe el mensaje…"/>
                <field name="attachment_ids" widget="many2many_binary"/>
                <footer>
                    <button name="action_send" type="object" string="Enviar" class="btn-primary" icon="fa-paper-plane"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_whatsapp_compose_partner" model="ir.actions.act_window">
        <field name="name">Enviar WhatsApp</field>
        <field name="res_model">whatsapp.compose</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">form,list</field>
    </record>
</odoo>
