<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cuentas: el genérico es de una compañía; los teléfonos de vendedor van sin compañía (compartidos). -->
        <record id="rule_whatsapp_account_company" model="ir.rule">
            <field name="name">Cuenta WhatsApp: multiempresa</field>
            <field name="model_id" ref="model_whatsapp_account"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_whatsapp_template_company" model="ir.rule">
            <field name="name">Plantilla WhatsApp: multiempresa</field>
            <field name="model_id" ref="model_whatsapp_template"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
