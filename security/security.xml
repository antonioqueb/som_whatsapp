<odoo>
    <record id="module_category_whatsapp" model="ir.module.category">
        <field name="name">WhatsApp</field>
        <field name="sequence">95</field>
    </record>
    <record id="privilege_whatsapp" model="res.groups.privilege">
        <field name="name">WhatsApp</field>
        <field name="category_id" ref="module_category_whatsapp"/>
        <field name="sequence">95</field>
    </record>
    <record id="group_whatsapp_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="privilege_id" ref="privilege_whatsapp"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Envía WhatsApp desde registros y consulta la bitácora.</field>
    </record>
    <record id="group_whatsapp_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="privilege_id" ref="privilege_whatsapp"/>
        <field name="implied_ids" eval="[(4, ref('group_whatsapp_user'))]"/>
        <field name="comment">Configura gateway, cuentas (QR), plantillas y puntos de conexión.</field>
    </record>
    <record id="whatsapp_account_rule_user_read" model="ir.rule">
        <field name="name">WhatsApp: cuentas visibles para usuarios</field>
        <field name="model_id" ref="model_whatsapp_account"/>
        <field name="groups" eval="[(4, ref('group_whatsapp_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="whatsapp_account_rule_user_own" model="ir.rule">
        <field name="name">WhatsApp: cada quien edita solo su cuenta</field>
        <field name="model_id" ref="model_whatsapp_account"/>
        <field name="groups" eval="[(4, ref('group_whatsapp_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/><field name="perm_write" eval="True"/><field name="perm_create" eval="True"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="whatsapp_account_rule_manager" model="ir.rule">
        <field name="name">WhatsApp: administradores todo</field>
        <field name="model_id" ref="model_whatsapp_account"/>
        <field name="groups" eval="[(4, ref('group_whatsapp_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="whatsapp_message_company_rule" model="ir.rule">
        <field name="name">WhatsApp: multi-compañía</field>
        <field name="model_id" ref="model_whatsapp_message"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
