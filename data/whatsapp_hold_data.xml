<odoo noupdate="1">
    <record id="wa_template_hold_seller_t2" model="whatsapp.template">
        <field name="name">Reserva · vendedor · vence en 2 días</field>
        <field name="model_id" ref="stock_lot_dimensions.model_stock_lot_hold_order"/>
        <field name="body">⏳ *Reserva {{ object.name }} vence {{ ctx.get('when') }}* · {{ ctx.get('expiry') }}
Cliente: {{ ctx.get('client') }} · Job: {{ ctx.get('job') }}
{{ ctx.get('lines') }}
🔗 {{ ctx.get('link') }}</field>
    </record>
    <record id="wa_template_hold_seller_t0" model="whatsapp.template">
        <field name="name">Reserva · vendedor · vence hoy</field>
        <field name="model_id" ref="stock_lot_dimensions.model_stock_lot_hold_order"/>
        <field name="body">⚠️ *Reserva {{ object.name }} vence HOY a las {{ ctx.get('expiry_time') }}*
Cliente: {{ ctx.get('client') }} · Job: {{ ctx.get('job') }}
{{ ctx.get('lines') }}
Renuévala o conviértela en venta; al vencer, el material se libera.
🔗 {{ ctx.get('link') }}</field>
    </record>
    <record id="wa_template_hold_client" model="whatsapp.template">
        <field name="name">Reserva · cliente · vence hoy/mañana</field>
        <field name="model_id" ref="stock_lot_dimensions.model_stock_lot_hold_order"/>
        <field name="body">Hola {{ object.partner_id.name }}, le saluda {{ object.company_id.name }}.
Su reserva *{{ object.name }}*{{ ctx.get('job_suffix') }} ({{ ctx.get('lines_short') }}) vence {{ ctx.get('when') }}, {{ ctx.get('expiry') }} hora de Monterrey; al vencer, el material se libera.
{{ ctx.get('seller_block') }}</field>
    </record>

    <record id="wa_event_hold_seller_t2" model="whatsapp.event">
        <field name="name">Reserva vence en 2 días → vendedor</field>
        <field name="key">hold.seller_t2</field>
        <field name="model_id" ref="stock_lot_dimensions.model_stock_lot_hold_order"/>
        <field name="template_id" ref="wa_template_hold_seller_t2"/>
        <field name="recipient_mode">partner_field</field>
        <field name="recipient_path">user_id.partner_id</field>
        <field name="trigger">manual</field>
        <field name="notes">Lo dispara el cron "WhatsApp: avisos de reservas" la mañana de T-2 (Ajustes › WhatsApp › hora de envío).</field>
    </record>
    <record id="wa_event_hold_seller_t0" model="whatsapp.event">
        <field name="name">Reserva vence hoy → vendedor</field>
        <field name="key">hold.seller_t0</field>
        <field name="model_id" ref="stock_lot_dimensions.model_stock_lot_hold_order"/>
        <field name="template_id" ref="wa_template_hold_seller_t0"/>
        <field name="recipient_mode">partner_field</field>
        <field name="recipient_path">user_id.partner_id</field>
        <field name="trigger">manual</field>
        <field name="notes">Lo dispara el cron la mañana del día del vencimiento.</field>
    </record>
    <record id="wa_event_hold_client" model="whatsapp.event">
        <field name="name">Reserva por vencer → cliente</field>
        <field name="key">hold.client_expiry</field>
        <field name="model_id" ref="stock_lot_dimensions.model_stock_lot_hold_order"/>
        <field name="template_id" ref="wa_template_hold_client"/>
        <field name="recipient_mode">partner_field</field>
        <field name="recipient_path">partner_id</field>
        <field name="trigger">manual</field>
        <field name="notes">Lo dispara el cron la mañana del vencimiento (o la anterior si vence temprano). Solo si el cliente tiene teléfono.</field>
    </record>
</odoo>
