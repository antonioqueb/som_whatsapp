<odoo>
    <record id="cron_whatsapp_send_queue" model="ir.cron">
        <field name="name">WhatsApp: enviar cola</field>
        <field name="model_id" ref="model_whatsapp_message"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_queue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_whatsapp_sync_status" model="ir.cron">
        <field name="name">WhatsApp: sincronizar estado de cuentas</field>
        <field name="model_id" ref="model_whatsapp_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_status()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_wa_hold_notices" model="ir.cron">
        <field name="name">WhatsApp: avisos de reservas (vendedor y cliente)</field>
        <field name="model_id" ref="stock_lot_dimensions.model_stock_lot_hold_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_wa_hold_notices()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_whatsapp_ai_process" model="ir.cron">
        <field name="name">WhatsApp IA: atender mensajes pendientes</field>
        <field name="model_id" ref="model_whatsapp_ai_assistant"/>
        <field name="state">code</field>
        <field name="code">model._cron_process()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
