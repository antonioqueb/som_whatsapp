<odoo noupdate="1">
    <record id="wa_template_sale_confirmed" model="whatsapp.template">
        <field name="name">Venta confirmada · cliente (PDF)</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="attach_report_id" ref="sale.action_report_saleorder"/>
        <field name="body">Hola {{ object.partner_id.name }}, le saluda {{ object.company_id.name }}.
Su pedido *{{ object.name }}*{{ ctx.get('job_suffix') }} quedó confirmado; adjuntamos el documento.
{{ ctx.get('seller_block') }}</field>
    </record>
    <record id="wa_event_sale_confirmed" model="whatsapp.event">
        <field name="name">Venta confirmada → cliente (con PDF)</field>
        <field name="key">sale.order.confirmed</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="template_id" ref="wa_template_sale_confirmed"/>
        <field name="recipient_mode">partner_field</field>
        <field name="recipient_path">partner_id</field>
        <field name="trigger">manual</field>
        <field name="notes">Envío MANUAL: botón "WhatsApp al cliente" en la orden (el vendedor elige el documento). No se dispara al confirmar.</field>
    </record>
</odoo>
