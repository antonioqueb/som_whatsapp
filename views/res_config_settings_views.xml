<odoo>
    <record id="res_config_settings_view_form_whatsapp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.whatsapp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="WhatsApp" string="WhatsApp" name="som_whatsapp" groups="som_whatsapp.group_whatsapp_manager">
                    <block title="Gateway Baileys" name="whatsapp_gateway_block">
                        <setting string="Conexión al gateway" help="Servicio Node (Baileys) con API HTTP. Dentro de Docker: http://som-whatsapp-gateway:3000">
                            <div class="row mt8">
                                <label for="wa_gateway_url" class="col-lg-4 o_light_label"/><field name="wa_gateway_url"/>
                            </div>
                            <div class="row mt8">
                                <label for="wa_api_key" class="col-lg-4 o_light_label"/><field name="wa_api_key" password="True"/>
                            </div>
                            <div class="row mt8">
                                <label for="wa_webhook_token" class="col-lg-4 o_light_label"/><field name="wa_webhook_token" password="True"/>
                            </div>
                            <div class="row mt8">
                                <label for="wa_default_country_code" class="col-lg-4 o_light_label"/><field name="wa_default_country_code"/>
                            </div>
                            <div class="row mt8">
                                <label for="wa_timeout" class="col-lg-4 o_light_label"/><field name="wa_timeout"/>
                            </div>
                            <div class="mt16">
                                <button name="action_wa_test" type="object" string="Probar conexión" class="btn-primary" icon="fa-plug"/>
                            </div>
                            <div class="text-muted mt8">
                                El webhook de entrada es <code>/som_whatsapp/webhook</code>; el gateway debe apuntar ahí con el mismo token.
                            </div>
                        </setting>
                    </block>
                    <block title="Seguimiento con el asesor" name="whatsapp_followup_block">
                        <setting string="Número intermediario" help="Este número solo notifica. Todo mensaje al cliente indica que el seguimiento, pagos y dudas son con su asesor (liga directa a su chat). Si el cliente escribe aquí, se le reenvía al asesor y se le responde automáticamente.">
                            <div class="row mt8">
                                <label for="wa_notice_text" class="col-lg-12 o_light_label"/>
                                <field name="wa_notice_text" placeholder="⚠️ Este número es exclusivo para notificaciones automáticas y no es atendido…"/>
                            </div>
                            <div class="row mt8">
                                <label for="wa_autoreply_cooldown_hours" class="col-lg-6 o_light_label"/><field name="wa_autoreply_cooldown_hours"/>
                            </div>
                            <div class="row mt8">
                                <label for="wa_fallback_forward_phone" class="col-lg-6 o_light_label"/><field name="wa_fallback_forward_phone"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Teléfonos de vendedores" name="whatsapp_sellers_block">
                        <setting string="Cada vendedor desde su número" help="Con su teléfono vinculado (menú WhatsApp › Mi WhatsApp), sus avisos, documentos y reservas salen desde su número sin la nota de 'seguimiento con su asesor', y las respuestas de clientes se registran en la orden. Sin vincular: todo sale del número genérico. Chats personales del vendedor nunca se guardan.">
                            <div class="row mt8"><field name="wa_seller_accounts"/></div>
                        </setting>
                    </block>
                    <block title="Anti-baneo" name="whatsapp_antiban_block">
                        <setting string="Ritmo humano" help="Goteo con pausas aleatorias y 'escribiendo…' antes de cada mensaje; tope diario con rampa para números nuevos.">
                            <div class="row mt8"><label for="wa_max_per_minute" class="col-lg-7 o_light_label"/><field name="wa_max_per_minute"/></div>
                            <div class="row mt8"><label for="wa_jitter_min" class="col-lg-7 o_light_label"/><field name="wa_jitter_min"/></div>
                            <div class="row mt8"><label for="wa_jitter_max" class="col-lg-7 o_light_label"/><field name="wa_jitter_max"/></div>
                            <div class="row mt8"><label for="wa_daily_cap" class="col-lg-7 o_light_label"/><field name="wa_daily_cap"/></div>
                            <div class="row mt8"><field name="wa_warmup"/></div>
                        </setting>
                        <setting string="Horario y prioridades" help="Fuera de ventana la cola espera; en domingo solo salen los urgentes (vencimientos). Los avisos de reservas se reparten al azar en la mañana.">
                            <div class="row mt8"><label for="wa_window_start" class="col-lg-7 o_light_label"/><field name="wa_window_start"/></div>
                            <div class="row mt8"><label for="wa_window_end" class="col-lg-7 o_light_label"/><field name="wa_window_end"/></div>
                            <div class="row mt8"><field name="wa_sunday_urgent_only"/></div>
                            <div class="row mt8"><label for="wa_hold_spread_minutes" class="col-lg-7 o_light_label"/><field name="wa_hold_spread_minutes"/></div>
                        </setting>
                        <setting string="Baja y detector de bloqueos" help="Quien escriba una palabra de baja no vuelve a recibir mensajes (lista de baja). Si 5 de 6 envíos fallan o los mensajes dejan de entregarse, la cuenta se pausa sola y avisa a los administradores.">
                            <div class="row mt8"><label for="wa_optout_keywords" class="col-lg-12 o_light_label"/><field name="wa_optout_keywords" placeholder="BAJA,STOP,ALTO,NO ME ESCRIBAS"/></div>
                            <div class="row mt8"><field name="wa_health_guard"/></div>
                        </setting>
                        <setting string="Del lado del teléfono (manual)" help="Lo que Meta pondera y no se puede hacer desde Odoo.">
                            <ul class="mb0">
                                <li>WhatsApp <b>Business</b> en el teléfono: nombre "SOM Group · Avisos", foto, descripción, dirección y horario.</li>
                                <li>Que una persona use el número de vez en cuando desde el teléfono (leer, contestar algún chat).</li>
                                <li>Un <b>segundo número</b> vinculado como cuenta adicional y calentado: si uno cae, la cola cambia sola a la otra cuenta conectada.</li>
                                <li>No cerrar/abrir la sesión en horario activo; no vincular el número a otros bots.</li>
                            </ul>
                        </setting>
                    </block>
                    <block title="Reservas (holds)" name="whatsapp_holds_block">
                        <setting string="Avisos de vencimiento" help="Vendedor: 2 días antes y el día del vencimiento. Cliente: la mañana del vencimiento (solo si tiene teléfono).">
                            <div class="row mt8">
                                <label for="wa_hold_morning_hour" class="col-lg-6 o_light_label"/><field name="wa_hold_morning_hour"/>
                            </div>
                            <div class="row mt8">
                                <label for="wa_hold_client_min_hours" class="col-lg-6 o_light_label"/><field name="wa_hold_client_min_hours"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
    <record id="action_whatsapp_config" model="ir.actions.act_window">
        <field name="name">Ajustes WhatsApp</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'som_whatsapp'}</field>
    </record>
</odoo>
