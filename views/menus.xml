<odoo>
    <!-- Solo administradores de WhatsApp ven la app (27 sep 2026). Los
         vendedores siguen siendo "Usuario" para poder mandar desde sus
         documentos (Enviar por WhatsApp), pero no abren el módulo. En un
         menú existente groups SUMA: el "-" quita el grupo Usuario viejo. -->
    <menuitem id="menu_whatsapp_root" name="WhatsApp" sequence="80"
              web_icon="som_whatsapp,static/description/icon.svg" groups="-som_whatsapp.group_whatsapp_user,som_whatsapp.group_whatsapp_manager"/>
    <menuitem id="menu_whatsapp_my_account" name="Mi WhatsApp" parent="menu_whatsapp_root" action="action_whatsapp_my_account" sequence="5"/>
    <menuitem id="menu_whatsapp_messages" name="Mensajes" parent="menu_whatsapp_root" action="action_whatsapp_message" sequence="10"/>
    <menuitem id="menu_whatsapp_accounts" name="Cuentas" parent="menu_whatsapp_root" action="action_whatsapp_account" sequence="20" groups="som_whatsapp.group_whatsapp_manager"/>
    <menuitem id="menu_whatsapp_templates" name="Plantillas" parent="menu_whatsapp_root" action="action_whatsapp_template" sequence="30" groups="som_whatsapp.group_whatsapp_manager"/>
    <menuitem id="menu_whatsapp_events" name="Puntos de conexión" parent="menu_whatsapp_root" action="action_whatsapp_event" sequence="40" groups="som_whatsapp.group_whatsapp_manager"/>
    <menuitem id="menu_whatsapp_blocklist" name="Lista de baja" parent="menu_whatsapp_root" action="action_whatsapp_blocklist" sequence="50" groups="som_whatsapp.group_whatsapp_manager"/>
    <menuitem id="menu_whatsapp_config" name="Ajustes" parent="menu_whatsapp_root" action="action_whatsapp_config" sequence="90" groups="som_whatsapp.group_whatsapp_manager"/>
</odoo>
